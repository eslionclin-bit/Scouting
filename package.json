{
  "name": "volley-scouting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first volleybal scouting-app — datamodel, lokale opslag en sync-laag",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:demo": "vite build --config vite.config.demo.ts && node scripts/build-demo.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.0.5"
  }
}
